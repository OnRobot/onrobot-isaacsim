#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "onrobot_rg6"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "onrobot_rg6"
{
    over "Physics"
    {
        def MjcActuator "finger_joint_actuator"
        {
            uniform double[] mjc:biasPrm = [0, -0.8726646304130554, -0.05235987901687622, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform double mjc:forceRange:max = 16.170000076293945
            uniform double mjc:forceRange:min = -16.170000076293945
            uniform double[] mjc:gainPrm = [0.8726646304130554, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:gainType = "fixed"
            custom rel mjc:target
            prepend rel mjc:target = </onrobot_rg6/Physics/finger_joint>
        }

        def MjcActuator "right_finger_base_link_actuator"
