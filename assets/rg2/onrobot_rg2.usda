#usda 1.0
(
    customLayerData = {
        string creator = "OnRobot RG2 PhysX Asset Structure 3.0"
        dictionary omni_layer = {
            string authoring_layer = "./onrobot_rg2.usda"
        }
    }
    defaultPrim = "onrobot_rg2"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

    def Xform "onrobot_rg2" (
    prepend references = @./payloads/base.usda@
    variants = {
        string Physics = "physx_parallel_grip"
    }
    append variantSets = "Physics"
)
{
    variantSet "Physics" = {
        "none" {
        }
        "physics" (
            prepend payload = @./payloads/Physics/physics.usda@
        ) {
        }
        "physx" (
            prepend payload = @./payloads/Physics/physx.usda@
        ) {
        }
        "physx_parallel_grip" (
            prepend payload = @./payloads/Physics/physx_parallel_grip.usda@
        ) {
        }
        "physx_parallel_grip_tip_contact" (
            prepend payload = @./payloads/Physics/physx_parallel_grip_tip_contact.usda@
        ) {
        }
    }
}

def PhysicsScene "PhysicsScene" (
    prepend apiSchemas = ["PhysxSceneAPI"]
)
{
    # The default asset selects the explicit fingertip-contact variant. Other
    # variants remain available for controlled collision diagnostics.
    bool physxScene:enableStabilization = 1
    uint physxScene:gpuFoundLostAggregatePairsCapacity = 8192
}
