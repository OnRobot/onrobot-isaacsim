#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "onrobot_2fg7"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "onrobot_2fg7"
{
    over "Physics"
    {
        def MjcActuator "finger_stroke_actuator"
        {
            uniform double[] mjc:biasPrm = [0, -20000, -282.84271240234375, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform double mjc:forceRange:max = 280
            uniform double mjc:forceRange:min = -280
            uniform double[] mjc:gainPrm = [20000, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:gainType = "fixed"
            custom rel mjc:target
            prepend rel mjc:target = </onrobot_2fg7/Physics/finger_stroke>
        }

        def MjcActuator "left_finger_base_joint_actuator" (
            active = false
        )
        {
            uniform double mjc:forceRange:max = 140
            uniform double mjc:forceRange:min = -140
            custom rel mjc:target
            prepend rel mjc:target = </onrobot_2fg7/Physics/left_finger_base_joint>
        }

        over "root_joint"
        {
        }

        over "finger_stroke" (
            delete apiSchemas = ["PhysicsDriveAPI:linear", "PhysicsJointStateAPI:linear"]
            prepend apiSchemas = ["NewtonJointAPI"]
        )
        {
            float newton:armature = 1
            float newton:velocityLimit = 0.45
        }

        over "right_fingertip_joint"
        {
        }

        over "left_finger_base_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:linear", "PhysicsJointStateAPI:linear"]
            prepend apiSchemas = ["NewtonJointAPI"]
        )
        {
            float newton:armature = 0
            float newton:velocityLimit = 0.45
        }

        over "left_fingertip_joint"
        {
        }
    }

    over "Geometry"
    {
        over "base_link"
        {
            over "right_finger_base_link"
            {
                over "right_fingertip_link"
                {
                    over "silicone_fingertip_link"
                    {
                    }
                }

                over "finger_base_link"
                {
                }
            }

            over "left_finger_base_link"
            {
                over "left_fingertip_link"
                {
                    over "silicone_fingertip_link"
                    {
                    }
                }

                over "finger_base_link"
                {
                }
            }

            over "base_link"
            {
            }
        }
    }

    over "Materials"
    {
    }

    over "VisualMaterials"
    {
    }
}

