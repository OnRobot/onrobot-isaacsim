#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "onrobot_2fg7"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "onrobot_2fg7"
{
    over "Physics"
    {
        over "root_joint" (
            prepend apiSchemas = ["PhysxArticulationAPI"]
        )
        {
            bool physxArticulation:enabledSelfCollisions = 1
            int physxArticulation:solverPositionIterationCount = 64
        }

        over "finger_stroke" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float drive:linear:physics:maxForce = 280
            float physxJoint:armature = 1
            float physxJoint:maxJointVelocity = 0.45
        }

        over "left_finger_base_joint" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotX"]
            delete apiSchemas = ["PhysicsDriveAPI:linear"]
        )
        {
            float physxJoint:maxJointVelocity = 0.45
            float physxMimicJoint:rotX:dampingRatio = 0
            float physxMimicJoint:rotX:gearing = -1
            float physxMimicJoint:rotX:naturalFrequency = 0
            float physxMimicJoint:rotX:offset = 0
            rel physxMimicJoint:rotX:referenceJoint = </onrobot_2fg7/Physics/finger_stroke>
        }
    }
}
