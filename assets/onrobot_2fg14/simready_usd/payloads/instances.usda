    def Xform "geo_28" (
        prepend references = @./geometries.usd@</Geometries/geo_28>
    )
    {
        over "geo_28" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/geo_28/VisualMaterials/Mtl>
        }

        def Scope "VisualMaterials"
        {
            def Material "Mtl" (
