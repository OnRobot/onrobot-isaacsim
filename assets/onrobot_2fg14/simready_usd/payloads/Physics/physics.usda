#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "onrobot_2fg14"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "onrobot_2fg14"
{
    over "Geometry"
    {
        over "base_link" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsFilteredPairsAPI"]
        )
        {
            point3f physics:centerOfMass = (-0.00015729, 0.00003543, 0.069388)
            float3 physics:diagonalInertia = (0.0011865998, 0.0019804963, 0.001999704)
            rel physics:filteredPairs = [
                </onrobot_2fg14/Geometry/right_finger_base_link>,
                </onrobot_2fg14/Geometry/right_fingertip_link>,
                </onrobot_2fg14/Geometry/left_finger_base_link>,
                </onrobot_2fg14/Geometry/left_fingertip_link>,
            ]
            float physics:mass = 1.4087
            quatf physics:principalAxes = (0.7120779, -0.70210046, -0.00021362297, 0.00012037633)
        }

        over "right_fingertip_link" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsFilteredPairsAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </onrobot_2fg14/Physics/fingertip_physics_material>
            point3f physics:centerOfMass = (0.01595, -0.0000026319, 0.0073333)
            float3 physics:diagonalInertia = (0.000009074188, 0.00001347, 0.000019634314)
            rel physics:filteredPairs = </onrobot_2fg14/Geometry/left_finger_base_link>
            float physics:mass = 0.053363
            quatf physics:principalAxes = (-0.0000016398834, 0.9918657, -0.000001369811, 0.12728904)
        }

        over "left_fingertip_link" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </onrobot_2fg14/Physics/fingertip_physics_material>
            point3f physics:centerOfMass = (0.015961, -2.5916e-8, 0.0073333)
            float3 physics:diagonalInertia = (0.000009074188, 0.00001347, 0.000019634314)
            float physics:mass = 0.053363
            quatf physics:principalAxes = (-0.0000016398834, 0.9918657, -0.000001369811, 0.12728904)
        }

        over "right_finger_base_link" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsFilteredPairsAPI"]
        )
        {
            point3f physics:centerOfMass = (-0.006, -2.6252e-17, -1.5092e-15)
            float3 physics:diagonalInertia = (2.1589e-7, 4.5646e-7, 5.775e-7)
            rel physics:filteredPairs = [
                </onrobot_2fg14/Geometry/right_fingertip_link>,
                </onrobot_2fg14/Geometry/left_finger_base_link>,
                </onrobot_2fg14/Geometry/left_fingertip_link>,
            ]
            float physics:mass = 0.014039
            quatf physics:principalAxes = (0.5, 0.5, 0.5, 0.5)
        }

        over "left_finger_base_link" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsFilteredPairsAPI"]
        )
        {
            point3f physics:centerOfMass = (-0.006, -1.3226e-17, 1.5127e-15)
            float3 physics:diagonalInertia = (2.1589e-7, 4.5646e-7, 5.775e-7)
            rel physics:filteredPairs = </onrobot_2fg14/Geometry/left_fingertip_link>
            float physics:mass = 0.014039
            quatf physics:principalAxes = (0.5, 0.5, 0.5, 0.5)
        }
    }

    over "Physics"
    {
        def Material "fingertip_physics_material" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.5
            float physics:staticFriction = 0.6
            float physics:restitution = 0
            token physxMaterial:frictionCombineMode = "average"
        }

        def PhysicsPrismaticJoint "finger_stroke" (
            prepend apiSchemas = ["PhysicsDriveAPI:linear", "PhysicsJointStateAPI:linear"]
        )
        {
            float drive:linear:physics:damping = 5
            float drive:linear:physics:maxForce = 280
            float drive:linear:physics:stiffness = 1000
            float drive:linear:physics:targetPosition = 0
            float drive:linear:physics:targetVelocity = 0
            uniform token drive:linear:physics:type = "force"
            uniform token physics:axis = "Z"
            custom rel physics:body0
            prepend rel physics:body0 = </onrobot_2fg14/Geometry/base_link>
            custom rel physics:body1
            prepend rel physics:body1 = </onrobot_2fg14/Geometry/right_finger_base_link>
            point3f physics:localPos0 = (0.017995, 0, 0.117)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (-0.0000025973434, 0.70710546, 0.000002597353, 0.7071081)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = 0
            float physics:upperLimit = 0.025
            custom float urdf:limit:effort = 280
            custom float urdf:limit:velocity = 0.45
        }

        def PhysicsPrismaticJoint "left_finger_base_joint" (
            prepend apiSchemas = ["NewtonMimicAPI", "PhysicsDriveAPI:linear", "PhysicsJointStateAPI:linear"]
        )
        {
            float drive:linear:physics:damping = 5
            float drive:linear:physics:maxForce = 280
            float drive:linear:physics:stiffness = 1000
            uniform token drive:linear:physics:type = "force"
            rel newton:mimicJoint = </onrobot_2fg14/Physics/finger_stroke>
            uniform token physics:axis = "Z"
            custom rel physics:body0
            prepend rel physics:body0 = </onrobot_2fg14/Geometry/base_link>
            custom rel physics:body1
            prepend rel physics:body1 = </onrobot_2fg14/Geometry/left_finger_base_link>
            point3f physics:localPos0 = (-0.017995, 0, 0.117)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (-0.70710546, 0, 0.7071081, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = 0
            float physics:upperLimit = 0.025
            custom float urdf:limit:effort = 280
            custom float urdf:limit:velocity = 0.45
        }

        def PhysicsFixedJoint "root_joint" (
            prepend apiSchemas = ["PhysicsArticulationRootAPI"]
        )
        {
            custom rel physics:body0
            custom rel physics:body1 = </onrobot_2fg14/Geometry/base_link>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "right_fingertip_joint"
        {
            custom rel physics:body0
            prepend rel physics:body0 = </onrobot_2fg14/Geometry/right_finger_base_link>
            custom rel physics:body1
            prepend rel physics:body1 = </onrobot_2fg14/Geometry/right_fingertip_link>
            point3f physics:localPos0 = (-1.3877788e-17, 2.646978e-23, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "left_fingertip_joint"
        {
            custom rel physics:body0
            prepend rel physics:body0 = </onrobot_2fg14/Geometry/left_finger_base_link>
            custom rel physics:body1
            prepend rel physics:body1 = </onrobot_2fg14/Geometry/left_fingertip_link>
            point3f physics:localPos0 = (1.3877788e-17, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
    }
}
