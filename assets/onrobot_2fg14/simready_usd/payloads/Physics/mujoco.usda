#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "onrobot_2fg14"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "onrobot_2fg14"
{
    over "Physics"
    {
        def MjcActuator "finger_stroke_actuator"
        {
            uniform double[] mjc:biasPrm = [0, -150, -5, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform double mjc:forceRange:max = 280
            uniform double mjc:forceRange:min = -280
            uniform double[] mjc:gainPrm = [150, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:gainType = "fixed"
            custom rel mjc:target
            prepend rel mjc:target = </onrobot_2fg14/Physics/finger_stroke>
        }

        def MjcActuator "left_finger_base_joint_actuator"
        {
            uniform double[] mjc:biasPrm = [0, -150, -5, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform double mjc:forceRange:max = 280
            uniform double mjc:forceRange:min = -280
            uniform double[] mjc:gainPrm = [150, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:gainType = "fixed"
            custom rel mjc:target
            prepend rel mjc:target = </onrobot_2fg14/Physics/left_finger_base_joint>
        }

        over "root_joint"
        {
        }

        over "finger_stroke" (
            delete apiSchemas = ["PhysicsDriveAPI:linear", "PhysicsJointStateAPI:linear"]
        )
        {
        }

        over "right_fingertip_joint"
        {
        }

        over "left_finger_base_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:linear", "PhysicsJointStateAPI:linear"]
        )
        {
        }

        over "left_fingertip_joint"
        {
        }
    }

