def Xform "onrobot_2fg14" (
    prepend apiSchemas = ["SemanticsLabelsAPI:class", "SemanticsLabelsAPI:wikidata_qcode"]
    kind = "component"
    prepend references = @./payloads/base.usda@
    variants = {
        string Physics = "physx"
    }
    append variantSets = "Physics"
)
{
    token[] semantics:labels:class = ["robotic_gripper"]
    token[] semantics:labels:wikidata_qcode = ["Q1340324"]

    over "Physics"
    {
        over "finger_stroke"
        {
            float drive:linear:physics:damping = 900
            float drive:linear:physics:stiffness = 40000
            float drive:linear:physics:targetPosition = 0
            float physics:lowerLimit = 0
            float physics:upperLimit = 0.025
        }
    }

    over "Geometry"
    {
        over "left_finger_base_link"
        {
            over "finger_base_link_1"
            {
                token visibility = "invisible"
            }
        }

        over "right_finger_base_link"
        {
            over "finger_base_link_1"
            {
                token visibility = "invisible"
            }
        }
    }
    variantSet "Physics" = {
        "mujoco" (
            prepend payload = @./payloads/Physics/mujoco.usda@
        ) {

        }
        "none" {

        }
        "physics" (
            prepend payload = @./payloads/Physics/physics.usda@
        ) {

        }
        "physx" (
            prepend payload = @./payloads/Physics/physx.usda@
        ) {

        }
    }
}

