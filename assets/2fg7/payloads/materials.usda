        prepend token outputs:surface.connect = </Materials/Mtl2/PreviewSurface.outputs:surface>
        token outputs:volume (
            displayGroup = "Outputs"
        )

        def Shader "PreviewSurface" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPreviewSurface"
            prepend color3f inputs:diffuseColor.connect = </Materials/Mtl2.inputs:diffuseColor>
            prepend float inputs:metallic.connect = </Materials/Mtl2.inputs:metallic>
            prepend float inputs:opacity.connect = </Materials/Mtl2.inputs:opacity>
            prepend float inputs:roughness.connect = </Materials/Mtl2.inputs:roughness>
            token outputs:displacement
            token outputs:surface
        }
    }
}
