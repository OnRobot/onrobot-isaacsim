#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Scope "Materials"
{
    def Material "OnRobotAluminumHousing"
    {
        color3f inputs:diffuseColor = (0.55, 0.57, 0.6)
        float inputs:metallic = 0.6
        float inputs:opacity = 1
        float inputs:roughness = 0.4
        token inputs:wrapMode = "repeat"
        token outputs:displacement (
            displayGroup = "Outputs"
        )
        prepend token outputs:displacement.connect = </Materials/OnRobotAluminumHousing/PreviewSurface.outputs:displacement>
        token outputs:surface (
            displayGroup = "Outputs"
        )
        token outputs:surface.connect = </Materials/OnRobotAluminumHousing/PreviewSurface.outputs:surface>
        token outputs:volume (
            displayGroup = "Outputs"
        )

        def Shader "PreviewSurface" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor.connect = </Materials/OnRobotAluminumHousing.inputs:diffuseColor>
            float inputs:metallic.connect = </Materials/OnRobotAluminumHousing.inputs:metallic>
            float inputs:opacity.connect = </Materials/OnRobotAluminumHousing.inputs:opacity>
            float inputs:roughness.connect = </Materials/OnRobotAluminumHousing.inputs:roughness>
            token outputs:displacement
            token outputs:surface
        }
    }

