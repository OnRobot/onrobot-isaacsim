#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "onrobot_2fg7"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "onrobot_2fg7"
{
    over "Geometry"
    {
        over "base_link" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsFilteredPairsAPI"]
        )
        {
            rel physics:filteredPairs = [
                </onrobot_2fg7/Geometry/right_finger_base_link>,
                </onrobot_2fg7/Geometry/right_fingertip_link>,
                </onrobot_2fg7/Geometry/left_finger_base_link>,
                </onrobot_2fg7/Geometry/left_fingertip_link>
            ]
            point3f physics:centerOfMass = (-0.0002500683, -0.00012024929, 0.060492408)
            float3 physics:diagonalInertia = (0.00079591415, 0.0009697723, 0.0010568612)
            float physics:mass = 1.0136738
            quatf physics:principalAxes = (0.70802987, -0.70618117, -0.0010787388, 0.00082372787)
        }

        over "right_finger_base_link" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsFilteredPairsAPI"]
        )
        {
            rel physics:filteredPairs = [
                </onrobot_2fg7/Geometry/right_fingertip_link>,
                </onrobot_2fg7/Geometry/left_finger_base_link>,
                </onrobot_2fg7/Geometry/left_fingertip_link>
            ]
            point3f physics:centerOfMass = (-0.005503283, -0.004471855, -0.009706983)
            float3 physics:diagonalInertia = (4.317458e-7, 0.0000023808186, 0.0000027380563)
            float physics:mass = 0.008929251
            quatf physics:principalAxes = (0.7298252, 0.15736105, 0.6646323, -0.029266547)
        }

        over "right_fingertip_link" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsFilteredPairsAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </onrobot_2fg7/Physics/fingertip_physics_material>
            rel physics:filteredPairs = [
                </onrobot_2fg7/Geometry/left_finger_base_link>
            ]
            point3f physics:centerOfMass = (0.018361593, -0.000002116404, 0.005866226)
            float3 physics:diagonalInertia = (0.0000026813075, 0.00000584746, 0.0000076167835)
            float physics:mass = 0.032804266
            quatf physics:principalAxes = (-0.0016119543, 0.99602914, -0.00010576829, 0.08901339)
        }

        over "left_finger_base_link" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsFilteredPairsAPI"]
        )
        {
            rel physics:filteredPairs = [
                </onrobot_2fg7/Geometry/left_fingertip_link>
            ]
            point3f physics:centerOfMass = (0, 0, 0)
            float3 physics:diagonalInertia = (4.317458e-7, 0.0000023808186, 0.0000027380563)
            float physics:mass = 0.008929251
            quatf physics:principalAxes = (0.7298252, 0.15736105, 0.6646323, -0.029266547)
        }

        over "left_fingertip_link" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </onrobot_2fg7/Physics/fingertip_physics_material>
            point3f physics:centerOfMass = (0.018361593, -0.000002116404, 0.005866226)
            float3 physics:diagonalInertia = (0.0000026813075, 0.00000584746, 0.0000076167835)
            float physics:mass = 0.032804266
            quatf physics:principalAxes = (-0.0016119543, 0.99602914, -0.00010576829, 0.08901339)
        }
    }

    over "Physics"
    {
        def Material "fingertip_physics_material" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.5
            float physics:staticFriction = 0.6
            float physics:restitution = 0
            token physxMaterial:frictionCombineMode = "average"
        }

        def PhysicsPrismaticJoint "finger_stroke" (
            prepend apiSchemas = ["PhysicsDriveAPI:linear", "PhysicsJointStateAPI:linear"]
        )
        {
            float drive:linear:physics:maxForce = 140
            float drive:linear:physics:targetPosition = 0
            float drive:linear:physics:targetVelocity = 0
            uniform token physics:axis = "Z"
            custom rel physics:body0
            prepend rel physics:body0 = </onrobot_2fg7/Geometry/base_link>
            custom rel physics:body1
            prepend rel physics:body1 = </onrobot_2fg7/Geometry/right_finger_base_link>
            point3f physics:localPos0 = (0.0115, 0, 0.11299)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (-0.0000025973434, 0.70710546, 0.000002597353, 0.7071081)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = 0
            float physics:upperLimit = 0.019
            float state:linear:physics:position = 0
            float state:linear:physics:velocity = 0
            custom float urdf:limit:effort = 140
            custom float urdf:limit:velocity = 0.45
        }

        def PhysicsPrismaticJoint "left_finger_base_joint" (
            prepend apiSchemas = ["PhysicsJointStateAPI:linear"]
        )
        {
            uniform token physics:axis = "Z"
            custom rel physics:body0
            prepend rel physics:body0 = </onrobot_2fg7/Geometry/base_link>
            custom rel physics:body1
            prepend rel physics:body1 = </onrobot_2fg7/Geometry/left_finger_base_link>
            point3f physics:localPos0 = (-0.0115, 0, 0.11299)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (-0.70710546, 0, 0.7071081, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = 0
            float physics:upperLimit = 0.019
            float state:linear:physics:position = 0
            float state:linear:physics:velocity = 0
            custom float urdf:limit:effort = 140
            custom float urdf:limit:velocity = 0.45
        }

        def PhysicsFixedJoint "root_joint" (
            prepend apiSchemas = ["PhysicsArticulationRootAPI"]
        )
        {
            rel physics:body0
            custom rel physics:body1
            prepend rel physics:body1 = </onrobot_2fg7/Geometry/base_link>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "right_fingertip_joint"
        {
            custom rel physics:body0
            prepend rel physics:body0 = </onrobot_2fg7/Geometry/right_finger_base_link>
            custom rel physics:body1
            prepend rel physics:body1 = </onrobot_2fg7/Geometry/right_fingertip_link>
            point3f physics:localPos0 = (1.3877788e-17, -1.323489e-23, -1.7347235e-18)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "left_fingertip_joint"
        {
            custom rel physics:body0
            prepend rel physics:body0 = </onrobot_2fg7/Geometry/left_finger_base_link>
            custom rel physics:body1
            prepend rel physics:body1 = </onrobot_2fg7/Geometry/left_fingertip_link>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
    }
}
