                    over "silicone_fingertip_link"
                    {
                        over "geo_1_1_1"
                        {
                            rel physics:simulationOwner
                        }
                    }
                }

                over "finger_base_link"
                {
                    over "finger_base_link"
                    {
                        rel physics:simulationOwner
                    }
                }
            }

            over "base_link"
            {
                over "geo_39_1_1"
                {
