#usda 1.0
(
    defaultPrim = "onrobot_rg6"
    subLayers = [
        @./physics.usda@
    ]
)

over "onrobot_rg6" (
    prepend apiSchemas = ["PhysxArticulationAPI"]
)
{
    bool physxArticulation:enabledSelfCollisions = 1
    int physxArticulation:solverPositionIterationCount = 68
    int physxArticulation:solverVelocityIterationCount = 4

    over "Physics"
    {
        over "finger_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:armature = 1.715
            float physxJoint:maxJointVelocity = 48.660423
        }

        over "left_finger_base_joint" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotZ"]
        )
        {
            float physxJoint:armature = 0.0001
            float physxJoint:maxJointVelocity = 48.660423
            float physxMimicJoint:rotZ:dampingRatio = 1
            float physxMimicJoint:rotZ:gearing = 1
            float physxMimicJoint:rotZ:naturalFrequency = 5000
            float physxMimicJoint:rotZ:offset = 0
            rel physxMimicJoint:rotZ:referenceJoint = </onrobot_rg6/Physics/finger_joint>
        }

        over "left_finger_cover_joint" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotZ"]
        )
        {
            float physxJoint:armature = 0.0001
            float physxJoint:maxJointVelocity = 48.660423
            float physxMimicJoint:rotZ:dampingRatio = 1
            float physxMimicJoint:rotZ:gearing = -1
            float physxMimicJoint:rotZ:naturalFrequency = 5000
            float physxMimicJoint:rotZ:offset = 0
            rel physxMimicJoint:rotZ:referenceJoint = </onrobot_rg6/Physics/finger_joint>
        }

        over "left_inner_proximal_joint" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotZ"]
        )
        {
            float physxJoint:armature = 0.0001
            float physxJoint:maxJointVelocity = 48.660423
            float physxMimicJoint:rotZ:dampingRatio = 1
            float physxMimicJoint:rotZ:gearing = -1
            float physxMimicJoint:rotZ:naturalFrequency = 5000
            float physxMimicJoint:rotZ:offset = 0
            rel physxMimicJoint:rotZ:referenceJoint = </onrobot_rg6/Physics/finger_joint>
        }

        over "left_outer_proximal_finger_joint" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotZ"]
        )
        {
            float physxJoint:armature = 0.0001
            float physxJoint:maxJointVelocity = 48.660423
            float physxMimicJoint:rotZ:dampingRatio = 1
            float physxMimicJoint:rotZ:gearing = -1
            float physxMimicJoint:rotZ:naturalFrequency = 5000
            float physxMimicJoint:rotZ:offset = 0
            rel physxMimicJoint:rotZ:referenceJoint = </onrobot_rg6/Physics/finger_joint>
        }

        over "right_finger_base_link" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotZ"]
        )
        {
            float physxJoint:armature = 0.0001
            float physxJoint:maxJointVelocity = 48.660423
            float physxMimicJoint:rotZ:dampingRatio = 1
            float physxMimicJoint:rotZ:gearing = 1
            float physxMimicJoint:rotZ:naturalFrequency = 5000
            float physxMimicJoint:rotZ:offset = 0
            rel physxMimicJoint:rotZ:referenceJoint = </onrobot_rg6/Physics/finger_joint>
        }

        over "right_finger_cover_joint" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotZ"]
        )
        {
            float physxJoint:armature = 0.0001
            float physxJoint:maxJointVelocity = 48.660423
            float physxMimicJoint:rotZ:dampingRatio = 1
            float physxMimicJoint:rotZ:gearing = -1
            float physxMimicJoint:rotZ:naturalFrequency = 5000
            float physxMimicJoint:rotZ:offset = 0
            rel physxMimicJoint:rotZ:referenceJoint = </onrobot_rg6/Physics/finger_joint>
        }

        over "right_inner_proximal_finger_joint" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotZ"]
        )
        {
            float physxJoint:armature = 0.0001
            float physxJoint:maxJointVelocity = 48.660423
            float physxMimicJoint:rotZ:dampingRatio = 1
            float physxMimicJoint:rotZ:gearing = -1
            float physxMimicJoint:rotZ:naturalFrequency = 5000
            float physxMimicJoint:rotZ:offset = 0
            rel physxMimicJoint:rotZ:referenceJoint = </onrobot_rg6/Physics/finger_joint>
        }
    }
}
