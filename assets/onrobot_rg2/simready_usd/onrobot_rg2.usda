def Xform "onrobot_rg2" (
    prepend apiSchemas = ["SemanticsLabelsAPI:class", "SemanticsLabelsAPI:wikidata_qcode"]
    kind = "component"
    prepend references = @./payloads/base.usda@
    variants = {
        string Newton = "Disabled"
        string Physics = "physx_parallel_grip"
