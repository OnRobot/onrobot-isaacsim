    over "Physics"
    {
        def Material "fingertip_physics_material" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.5
            float physics:staticFriction = 0.6
            float physics:restitution = 0
            token physxMaterial:frictionCombineMode = "average"
        }

        def PhysicsFixedJoint "root_joint" (
        )
        {
            rel physics:body0 = </onrobot_rg2>
            rel physics:body1 = </onrobot_rg2/Geometry/base_link>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "body_joint"
        {
            uniform token physics:axis = "Z"
            rel physics:body0 = </onrobot_rg2/Geometry/base_link>
            rel physics:body1 = </onrobot_rg2/Geometry/body_link>
            point3f physics:localPos0 = (0, 0, 0.0473399981856)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0, 0.707106769085, 0, 0.707106769085)
            quatf physics:localRot1 = (0, -1, 0, 0)
        }

        def PhysicsRevoluteJoint "finger_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0.1396263402
            float drive:angular:physics:maxForce = 4.5
            float drive:angular:physics:stiffness = 1.74532925
            float drive:angular:physics:targetPosition = 60
            float drive:angular:physics:targetVelocity = 0
            uniform token physics:axis = "Z"
            rel physics:body0 = </onrobot_rg2/Geometry/body_link>
            rel physics:body1 = </onrobot_rg2/Geometry/right_outer_proximal_finger_link>
            point3f physics:localPos0 = (0.0759999975562, 0, -0.0169500000775)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.707105457783, -0.707108080387, 1.11022302463e-16, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = 0
            float physics:upperLimit = 70.0599975586
            float state:angular:physics:position = 60
            float state:angular:physics:velocity = 0
        }

        def PhysicsRevoluteJoint "right_finger_cover_arm_joint" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular"]
        )
        {
            uniform token physics:axis = "Z"
