#usda 1.0
(
    customLayerData = { string creator = "OnRobot RG2 PhysX Asset Structure 3.0" }
    defaultPrim = "onrobot_rg2"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

