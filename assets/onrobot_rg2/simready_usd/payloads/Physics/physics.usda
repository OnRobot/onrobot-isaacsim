    over "Physics"
    {
        def Material "fingertip_physics_material" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.5
            float physics:restitution = 0
            float physics:staticFriction = 0.6
            token physxMaterial:frictionCombineMode = "average"
        }

        def PhysicsFixedJoint "root_joint"
        {
            rel physics:body0 = </onrobot_rg2>
            rel physics:body1 = </onrobot_rg2/Geometry/base_link>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "body_joint"
        {
            uniform token physics:axis = "Z"
            rel physics:body0 = </onrobot_rg2/Geometry/base_link>
